<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Xcode normally writes this file when the
	     capability is switched on; it is checked in so a fresh clone already
	     has it. In Xcode: Runner → Signing & Capabilities → + Capability →
	     Push Notifications, which links this file to the target.
	     Use "production" for App Store / TestFlight builds. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
