# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Kept out on purpose: launch.json carries --dart-define API keys.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets and local env
.env
.env.*
*.env
*.local

# Android signing — a leaked upload key cannot be revoked, only abandoned.
*.jks
*.keystore
android/key.properties

# Gradle leaves generated copies of google-services.json under here, keys and
# all, which would otherwise walk straight past the ignore rule below.
android/app/build/
# Gradle also writes a top-level build/ with its problem reports.
android/build/
android/.gradle/
supabase/.temp/

# The pre-3.0 Firebase codebase, kept locally as a reference snapshot only.
# It contains a hardcoded OpenRouter key from before secrets moved to edge
# function env vars, so it must never be published.
lib_old/

# Firebase / GCP local config files (keep private)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
**/service-account*.json
**/*serviceAccount*.json
**/*secret*.json
**/*private_key*.pem

# graphify knowledge graph (regenerate with /graphify lib --update)
graphify-out/
